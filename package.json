{
  "name": "genbeya",
  "version": "0.0.1",
  "private": true,
  "description": "A desktop workspace for Git repositories: wiki, tasks, code and version control",
  "author": "Emanuel Knecht",
  "repository": "github:genbeya/genbeya",
  "main": "dist/electron/main.cjs",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "start": "node scripts/dev.mjs",
    "start:demo": "ng serve --configuration demo",
    "build": "ng build && node scripts/build-backend.mjs",
    "build:demo": "ng build --configuration demo",
    "check": "tsc -p tsconfig.backend.json && ng build --configuration development",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test:backend && npm run test:client",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "test:client": "ng test --watch=false",
    "e2e": "npm run build && playwright test",
    "e2e:demo": "npm run build:demo && playwright test --config playwright.demo.config.ts",
    "icons": "electron scripts/make-icons.mjs",
    "package": "npm run build && electron-builder",
    "package:deno": "ng build && node scripts/package-deno.mjs",
    "package:tauri": "ng build && cd src/shells/tauri && tauri build"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/stix-two-math": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lucide/angular": "^1.54.0",
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "^1.64.0",
    "@rockuml/angular": "^0.2.1",
    "@rockuml/core": "^0.2.1",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/cli": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "angular-eslint": "^22.5.0",
    "deno": "^2.9.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-text": "^4.0.2",
    "jsdom": "^30.1.2",
    "katex": "^0.19.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.1.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-decode-string": "^2.0.1",
    "micromark-util-types": "^2.0.3",
    "prettier": "^3.9.9",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rxjs": "~7.8",
    "tslib": "^2.8.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "fyi.genbeya.app",
    "productName": "Genbeya",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "dist/electron/**/*",
      "package.json",
      "!node_modules/node-pty/{deps,scripts,src,third_party,typings}/**",
      "!node_modules/node-pty/**/*.pdb"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "publish": null,
    "protocols": [
      {
        "name": "Genbeya link",
        "schemes": [
          "genbeya"
        ]
      }
    ],
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      "category": "Development",
      "icon": "build/icon.png"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "deno@2.9.6": true,
    "@parcel/watcher": false,
    "electron-winstaller": false,
    "lmdb": false,
    "msgpackr-extract": false,
    "node-pty@1.1.0": true
  },
  "overrides": {
    "katex": "$katex"
  }
}
