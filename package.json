{
  "name": "gitdesk",
  "version": "0.1.0",
  "private": true,
  "description": "A repository-native project workspace",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json && node scripts/copy-preload.mjs",
    "start": "electron .",
    "test": "npm run test:engine && npm run test:ui",
    "check": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package": "npm run build && electron-builder",
    "preview": "vite --host 127.0.0.1",
    "test:engine": "node --import tsx --test tests/engine.test.ts",
    "test:ui": "vitest run",
    "format": "prettier --write src electron shared tests scripts *.json *.ts README.md"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "dev.gitdesk.app",
    "productName": "GitDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "sample/**/*",
      "sample/.gitdesk.yml",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
