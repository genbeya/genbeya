{
  "name": "gitdesk",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop workspace for Git repositories: wiki, tasks, code and version control",
  "author": "Emanuel Knecht",
  "repository": "github:h3ll5ur7er/gitdesk",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:browser": "node scripts/dev-browser.mjs",
    "build": "tsc --noEmit && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build && node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc -p tsconfig.electron.json && node scripts/copy-preload.mjs",
    "start": "electron .",
    "check": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "npm run test:core && npm run test:ui",
    "test:core": "node --import tsx --test tests/core.test.ts",
    "test:ui": "vitest run",
    "package": "npm run build && electron-builder",
    "format": "prettier --write src core electron shared tests scripts *.json *.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-text": "^4.0.2",
    "lucide-react": "^0.468.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.1.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.3.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "dev.gitdesk.app",
    "productName": "GitDesk",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "publish": null,
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
