{
  "name": "genbeya",
  "displayName": "Genbeya",
  "description": "The wiki and the task board of your Git repository, kept as plain Markdown files, in VS Code",
  "preview": true,
  "pricing": "Free",
  "publisher": "genbeya",
  "author": "Emanuel Knecht",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://genbeya.fyi",
  "repository": {
    "type": "git",
    "url": "https://github.com/genbeya/genbeya"
  },
  "bugs": {
    "url": "https://github.com/genbeya/genbeya/issues"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#16171a",
    "theme": "dark"
  },
  "categories": ["Other"],
  "keywords": ["wiki", "tasks", "kanban", "board", "markdown", "git", "documentation", "project management", "todo"],
  "engines": {
    "vscode": "^1.140.0"
  },
  "extensionKind": ["workspace"],
  "main": "./extension.cjs",
  "activationEvents": ["workspaceContains:.genbeya.yml", "onWebviewPanel:genbeya.preview", "onWebviewPanel:genbeya.board"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Genbeya runs Git in the repository, which can run programs the repository configures."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "genbeya",
          "title": "Genbeya",
          "icon": "genbeya-mono.svg"
        }
      ]
    },
    "views": {
      "genbeya": [
        {
          "id": "genbeya.wiki",
          "name": "Wiki"
        },
        {
          "id": "genbeya.tasks",
          "name": "Tasks"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "genbeya.wiki",
        "contents": "Opening the repository…",
        "when": "genbeya.state == opening"
      },
      {
        "view": "genbeya.wiki",
        "contents": "Genbeya shows the wiki and the tasks of a Git repository.\n[Open Folder](command:vscode.openFolder)",
        "when": "genbeya.state == none"
      },
      {
        "view": "genbeya.wiki",
        "contents": "Genbeya couldn't open this folder as a Git repository.\n[Open Folder](command:vscode.openFolder)",
        "when": "genbeya.state == failed"
      },
      {
        "view": "genbeya.wiki",
        "contents": "This repository has no wiki pages yet.\n[New Page](command:genbeya.newPage)",
        "when": "genbeya.state == open"
      }
    ],
    "commands": [
      {
        "command": "genbeya.refresh",
        "title": "Refresh",
        "category": "Genbeya",
        "icon": "$(refresh)"
      },
      {
        "command": "genbeya.syncContent",
        "title": "Sync Content Branch",
        "category": "Genbeya",
        "icon": "$(sync)"
      },
      {
        "command": "genbeya.newPage",
        "title": "New Page…",
        "category": "Genbeya",
        "icon": "$(new-file)"
      },
      {
        "command": "genbeya.newTask",
        "title": "New Task…",
        "category": "Genbeya",
        "icon": "$(add)"
      },
      {
        "command": "genbeya.openBoard",
        "title": "Open Board",
        "category": "Genbeya",
        "icon": "$(project)"
      },
      {
        "command": "genbeya.preview",
        "title": "Preview",
        "category": "Genbeya",
        "icon": "$(open-preview)"
      },
      {
        "command": "genbeya.edit",
        "title": "Edit",
        "category": "Genbeya",
        "icon": "$(edit)"
      },
      {
        "command": "genbeya.setStatus",
        "title": "Status…",
        "category": "Genbeya"
      },
      {
        "command": "genbeya.setType",
        "title": "Type…",
        "category": "Genbeya"
      },
      {
        "command": "genbeya.setPriority",
        "title": "Priority…",
        "category": "Genbeya"
      },
      {
        "command": "genbeya.setAssignee",
        "title": "Assignee…",
        "category": "Genbeya"
      },
      {
        "command": "genbeya.setEpic",
        "title": "Epic…",
        "category": "Genbeya"
      },
      {
        "command": "genbeya.setLabels",
        "title": "Labels…",
        "category": "Genbeya"
      },
      {
        "command": "genbeya.renameTask",
        "title": "Rename…",
        "category": "Genbeya"
      },
      {
        "command": "genbeya.deleteTask",
        "title": "Delete Task",
        "category": "Genbeya"
      },
      {
        "command": "genbeya.movePage",
        "title": "Move or Rename…",
        "category": "Genbeya"
      },
      {
        "command": "genbeya.deletePage",
        "title": "Delete Page",
        "category": "Genbeya"
      },
      {
        "command": "genbeya.previewToSide",
        "title": "Open Preview to the Side",
        "category": "Genbeya",
        "icon": "$(open-preview)"
      },
      {
        "command": "genbeya.groupByEpic",
        "title": "Group by Epic",
        "category": "Genbeya",
        "icon": "$(folder)"
      },
      {
        "command": "genbeya.groupByStatus",
        "title": "Group by Status",
        "category": "Genbeya",
        "icon": "$(list-flat)"
      },
      {
        "command": "genbeya.followReference",
        "title": "Follow Reference",
        "category": "Genbeya"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "genbeya.newPage",
          "when": "view == genbeya.wiki && genbeya.state == open",
          "group": "navigation@1"
        },
        {
          "command": "genbeya.refresh",
          "when": "view == genbeya.wiki && genbeya.state == open",
          "group": "navigation@2"
        },
        {
          "command": "genbeya.openBoard",
          "when": "view == genbeya.tasks && genbeya.state == open",
          "group": "navigation@0"
        },
        {
          "command": "genbeya.newTask",
          "when": "view == genbeya.tasks && genbeya.state == open",
          "group": "navigation@1"
        },
        {
          "command": "genbeya.syncContent",
          "when": "view == genbeya.tasks && genbeya.contentBranch",
          "group": "navigation@2"
        },
        {
          "command": "genbeya.refresh",
          "when": "view == genbeya.tasks && genbeya.state == open",
          "group": "navigation@3"
        },
        {
          "command": "genbeya.groupByEpic",
          "when": "view == genbeya.tasks && genbeya.state == open && !genbeya.tasksByEpic",
          "group": "navigation@4"
        },
        {
          "command": "genbeya.groupByStatus",
          "when": "view == genbeya.tasks && genbeya.state == open && genbeya.tasksByEpic",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "genbeya.preview",
          "when": "view == genbeya.wiki && viewItem == page",
          "group": "inline@1"
        },
        {
          "command": "genbeya.edit",
          "when": "view == genbeya.wiki && viewItem == page",
          "group": "inline@2"
        },
        {
          "command": "genbeya.preview",
          "when": "view == genbeya.tasks && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "genbeya.edit",
          "when": "view == genbeya.tasks && viewItem == task",
          "group": "inline@2"
        },
        {
          "command": "genbeya.preview",
          "when": "view == genbeya.wiki && viewItem == page || view == genbeya.tasks && viewItem == task",
          "group": "1_open@1"
        },
        {
          "command": "genbeya.edit",
          "when": "view == genbeya.wiki && viewItem == page || view == genbeya.tasks && viewItem == task",
          "group": "1_open@2"
        },
        {
          "command": "genbeya.setStatus",
          "when": "view == genbeya.tasks && viewItem == task",
          "group": "2_properties@1"
        },
        {
          "command": "genbeya.setType",
          "when": "view == genbeya.tasks && viewItem == task",
          "group": "2_properties@2"
        },
        {
          "command": "genbeya.setPriority",
          "when": "view == genbeya.tasks && viewItem == task",
          "group": "2_properties@3"
        },
        {
          "command": "genbeya.setAssignee",
          "when": "view == genbeya.tasks && viewItem == task",
          "group": "2_properties@4"
        },
        {
          "command": "genbeya.setEpic",
          "when": "view == genbeya.tasks && viewItem == task",
          "group": "2_properties@5"
        },
        {
          "command": "genbeya.setLabels",
          "when": "view == genbeya.tasks && viewItem == task",
          "group": "2_properties@6"
        },
        {
          "command": "genbeya.renameTask",
          "when": "view == genbeya.tasks && viewItem == task",
          "group": "3_edit@1"
        },
        {
          "command": "genbeya.deleteTask",
          "when": "view == genbeya.tasks && viewItem == task",
          "group": "3_edit@2"
        },
        {
          "command": "genbeya.newPage",
          "when": "view == genbeya.wiki && viewItem == page",
          "group": "2_page@1"
        },
        {
          "command": "genbeya.movePage",
          "when": "view == genbeya.wiki && viewItem == page",
          "group": "2_page@2"
        },
        {
          "command": "genbeya.deletePage",
          "when": "view == genbeya.wiki && viewItem == page",
          "group": "2_page@3"
        }
      ],
      "editor/title": [
        {
          "command": "genbeya.edit",
          "when": "activeWebviewPanelId == genbeya.preview",
          "group": "navigation"
        },
        {
          "command": "genbeya.previewToSide",
          "when": "genbeya.documentArea && !activeWebviewPanelId",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "genbeya.refresh",
          "when": "genbeya.state == open"
        },
        {
          "command": "genbeya.syncContent",
          "when": "genbeya.contentBranch"
        },
        {
          "command": "genbeya.newPage",
          "when": "genbeya.state == open"
        },
        {
          "command": "genbeya.newTask",
          "when": "genbeya.state == open"
        },
        {
          "command": "genbeya.openBoard",
          "when": "genbeya.state == open"
        },
        {
          "command": "genbeya.edit",
          "when": "activeWebviewPanelId == genbeya.preview"
        },
        {
          "command": "genbeya.preview",
          "when": "false"
        },
        {
          "command": "genbeya.setStatus",
          "when": "false"
        },
        {
          "command": "genbeya.setType",
          "when": "false"
        },
        {
          "command": "genbeya.setPriority",
          "when": "false"
        },
        {
          "command": "genbeya.setAssignee",
          "when": "false"
        },
        {
          "command": "genbeya.setEpic",
          "when": "false"
        },
        {
          "command": "genbeya.setLabels",
          "when": "false"
        },
        {
          "command": "genbeya.renameTask",
          "when": "false"
        },
        {
          "command": "genbeya.deleteTask",
          "when": "false"
        },
        {
          "command": "genbeya.movePage",
          "when": "false"
        },
        {
          "command": "genbeya.deletePage",
          "when": "false"
        },
        {
          "command": "genbeya.previewToSide",
          "when": "genbeya.documentArea"
        },
        {
          "command": "genbeya.groupByEpic",
          "when": "genbeya.state == open && !genbeya.tasksByEpic"
        },
        {
          "command": "genbeya.groupByStatus",
          "when": "genbeya.state == open && genbeya.tasksByEpic"
        },
        {
          "command": "genbeya.followReference",
          "when": "false"
        }
      ]
    }
  }
}
