{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genbeya Tauri",
  "version": "0.4.0",
  "identifier": "fyi.genbeya.tauri",
  "build": {
    "frontendDist": "../../../../dist/client/browser"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["genbeya", "gitdesk"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "Genbeya",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "wix": { "upgradeCode": "b50af3c1-3f60-5e8e-b488-6364423e9c33" },
      "nsis": { "installerHooks": "windows/installer-hooks.nsh" }
    }
  }
}
