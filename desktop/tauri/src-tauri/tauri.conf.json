{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitDesk Tauri",
  "version": "0.1.0",
  "identifier": "dev.gitdesk.tauri",
  "build": {
    "frontendDist": "../../../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitDesk",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
