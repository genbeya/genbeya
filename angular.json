{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "genbeya": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "changeDetection": "OnPush"
        }
      },
      "root": "",
      "sourceRoot": "src/client",
      "prefix": "gd",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/client",
            "index": "src/client/index.html",
            "browser": "src/client/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/client/public"
              },
              {
                "glob": "rockuml.wasm",
                "input": "node_modules/@rockuml/core",
                "output": "/"
              }
            ],
            "styles": ["src/client/styles.css"],
            "allowedCommonJsDependencies": [
              "@braintree/sanitize-url",
              "cytoscape-cose-bilkent",
              "cytoscape-fcose",
              "dayjs",
              "elkjs",
              "extend"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "demo": {
              "outputPath": "dist/demo",
              "index": {
                "input": "src/client/index.demo.html",
                "output": "index.html"
              },
              "fileReplacements": [
                {
                  "replace": "src/client/app/platform/connect.ts",
                  "with": "src/client/app/platform/connect.demo.ts"
                }
              ],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "src/client/public"
                },
                {
                  "glob": "rockuml.wasm",
                  "input": "node_modules/@rockuml/core",
                  "output": "/"
                },
                {
                  "glob": "{lg2_opfs*.js,lg2_opfs*.wasm,COPYING}",
                  "input": "node_modules/wasm-git",
                  "output": "/wasm-git"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "host": "127.0.0.1",
            "port": 5173
          },
          "configurations": {
            "production": {
              "buildTarget": "genbeya:build:production"
            },
            "development": {
              "buildTarget": "genbeya:build:development"
            },
            "demo": {
              "buildTarget": "genbeya:build:demo"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "include": ["src/client/**/*.spec.ts"],
            "setupFiles": ["src/client/test-setup.ts"]
          }
        }
      }
    }
  }
}
